{  
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "types": ["node"],
    "rootDir": "./src",


    // Other Outputs
    "sourceMap": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "resolveJsonModule": true
  }
}
